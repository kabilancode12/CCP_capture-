# Copy this file to `.env` and set real values. `.env` is git-ignored; never commit it.
# These values are for LOCAL development only. Use a secrets manager on a server.
# Every variable is explained in docs/configuration.md.

# --- PostgreSQL (with pgvector) ---
# 127.0.0.1, not localhost: on Windows, localhost tries IPv6 first and adds about 2 s per connection.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=ccp
POSTGRES_USER=ccp
POSTGRES_PASSWORD=change-me-postgres

# --- MinIO (S3-compatible object storage for raw transcripts) ---
# MINIO_ROOT_* are used by Docker Compose to create the MinIO server.
MINIO_ROOT_USER=ccp-admin
MINIO_ROOT_PASSWORD=change-me-minio-min-8-chars
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# MINIO_ACCESS_KEY / MINIO_SECRET_KEY are what the application uses. Locally, use the same
# values as the root user. On a server, create a dedicated service account instead.
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=ccp-admin
MINIO_SECRET_KEY=change-me-minio-min-8-chars
MINIO_SECURE=false
# Bucket for raw transcripts; the application creates it on first use.
MINIO_BUCKET=ccp-raw

# --- Capture client (developer machines; set these in Claude Code's settings env block) ---
# Code snapshots are opt-in. They run when a capture project is configured (or CCP_SNAPSHOTS=true).
# CCP_SNAPSHOT_REMOTE=https://gitlab.example.com/claude-capture/my-repo-capture.git
# CCP_SNAPSHOT_REMOTE_BASE=https://gitlab.example.com/claude-capture
# CCP_SNAPSHOTS=true

# --- Ingestion API ---
CCP_API_HOST=127.0.0.1
CCP_API_PORT=8000
# Token that developers' machines send with every upload. At least 16 characters.
CCP_INGEST_TOKEN=change-me-ingest-token
# A session with no activity for this many minutes is marked closed.
CCP_SESSION_IDLE_MINUTES=30
# Largest transcript chunk the API accepts, in bytes (default 8 MiB).
CCP_MAX_CHUNK_BYTES=8388608

# --- Dashboards (optional; see docs/dashboards.md) ---
# Start Metabase with: docker compose --env-file .env -f infra/docker-compose.yml --profile dashboards up -d
# Password of the read-only database role that Metabase reads with (made by `ccp-db create-reader`).
CCP_READER_PASSWORD=change-me-reader-password
# CCP_READER_USER=ccp_reader
# Administrator account created in Metabase by `ccp-dashboards setup`. Use your own address.
CCP_METABASE_ADMIN_EMAIL=admin@example.com
CCP_METABASE_ADMIN_PASSWORD=change-me-metabase-admin
METABASE_PORT=3000
# Where Metabase reaches PostgreSQL (inside the Compose network it is `postgres`, port 5432).
# CCP_METABASE_DB_HOST=postgres
# CCP_METABASE_DB_PORT=5432
