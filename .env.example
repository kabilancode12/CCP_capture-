# Copy this file to `.env` and set real values. `.env` is git-ignored; never commit it.
# These values are for LOCAL development only. Use a secrets manager on a server.

# --- PostgreSQL (with pgvector) ---
POSTGRES_USER=ccp
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=ccp
POSTGRES_PORT=5432

# --- MinIO (S3-compatible object storage for raw transcripts) ---
MINIO_ROOT_USER=ccp-admin
MINIO_ROOT_PASSWORD=change-me-minio-min-8-chars
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# Bucket created automatically on first start.
MINIO_BUCKET=ccp-raw
