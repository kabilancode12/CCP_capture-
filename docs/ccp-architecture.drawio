<mxfile host="drawio" version="24.7.17"><diagram id="arch" name="1 · Architecture"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;CCP – Claude Capture Platform · full system architecture&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:12px'&gt;Green = built and running · Amber = built in part, or built but not switched on · Red dashed = to build. Solid arrows run today; red dashed arrows are the target flow.&lt;/span&gt;" style="text;html=1;fontSize=18;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1700" height="50" as="geometry"/></mxCell><mxCell id="c3" value="① Developer machine&lt;br&gt;(one Claude account per person)" style="swimlane;startSize=44;html=1;fontStyle=1;fontSize=13;rounded=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="320" height="1010" as="geometry"/></mxCell><mxCell id="c4" value="② Ingestion&lt;br&gt;(ccp-server, systemd user service)" style="swimlane;startSize=44;html=1;fontStyle=1;fontSize=13;rounded=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="360" y="70" width="320" height="1010" as="geometry"/></mxCell><mxCell id="c5" value="③ Processing&lt;br&gt;(indexer + plug-ins in ccp-server)" style="swimlane;startSize=44;html=1;fontStyle=1;fontSize=13;rounded=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="700" y="70" width="320" height="1010" as="geometry"/></mxCell><mxCell id="c6" value="④ Data stores" style="swimlane;startSize=44;html=1;fontStyle=1;fontSize=13;rounded=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1040" y="70" width="320" height="1010" as="geometry"/></mxCell><mxCell id="c7" value="⑤ AI calls · access · consumers" style="swimlane;startSize=44;html=1;fontStyle=1;fontSize=13;rounded=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1380" y="70" width="320" height="1010" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Claude Code&lt;/b&gt;&lt;br&gt;CLI ✔ · VS Code ✔ · Desktop app: not tested (R5)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="30" y="124" width="300" height="60" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Hooks&lt;/b&gt; – ~/.claude/settings.json (R1 R4 R6)&lt;br&gt;SessionStart · UserPromptSubmit · Stop · SubagentStop · PreCompact · SessionEnd&lt;br&gt;installed by &lt;i&gt;ccp-capture install&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="30" y="194" width="300" height="90" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;showThinkingSummaries = true&lt;/b&gt;&lt;br&gt;thinking summaries kept in the transcript (R13)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="30" y="294" width="300" height="50" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Capture client&lt;/b&gt; (ccp-capture, stdlib only)&lt;br&gt;• reads transcript + sub-agent files&lt;br&gt;• redacts secrets and personal data on the machine&lt;br&gt;• uploads in chunks, queues and retries when offline&lt;br&gt;• environment report: version, OS, IDE, terminal (R20 R21)&lt;br&gt;• backfill · kill switch CCP_CAPTURE_DISABLED=1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="30" y="354" width="300" height="125" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Hidden Git snapshots&lt;/b&gt; (R3 R12)&lt;br&gt;working tree after every reply →&lt;br&gt;refs/claude-capture/sessions/&amp;lt;id&amp;gt;/0001…&lt;br&gt;built, &lt;u&gt;opt-in, not switched on&lt;/u&gt; (CCP_SNAPSHOTS)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="30" y="489" width="300" height="95" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;CLAUDE.md reasoning rule&lt;/b&gt; (R13)&lt;br&gt;reply states options, pick, why" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;" vertex="1" parent="1"><mxGeometry x="30" y="594" width="300" height="60" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Git commit hook&lt;/b&gt; (R11)&lt;br&gt;adds trailer &lt;i&gt;CCP-Chat: &amp;lt;chat id&amp;gt;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;" vertex="1" parent="1"><mxGeometry x="30" y="664" width="300" height="60" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Memory watcher&lt;/b&gt; (R13 R19)&lt;br&gt;records reads / changes of memory and CLAUDE.md" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;" vertex="1" parent="1"><mxGeometry x="30" y="734" width="300" height="60" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Ingest API&lt;/b&gt; (Starlette)&lt;br&gt;• /v1 chunks, attachments, lifecycle, environment&lt;br&gt;• token authentication&lt;br&gt;• idempotent: same chunk twice = stored once&lt;br&gt;• raw object written before any indexing" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="370" y="124" width="300" height="110" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Session closer&lt;/b&gt;&lt;br&gt;marks sessions ended / idle" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="370" y="244" width="300" height="50" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Job queue&lt;/b&gt; (table job)&lt;br&gt;one index job per upload" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="370" y="304" width="300" height="50" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Plug-in host&lt;/b&gt;&lt;br&gt;after-index callbacks + web mounts;&lt;br&gt;catalog · decisions · explorer (CCP_*_ENABLED)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="370" y="364" width="300" height="70" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Snapshot push&lt;/b&gt;&lt;br&gt;to capture Git remote, retry queue (opt-in)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="370" y="444" width="300" height="60" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Auto commit linking&lt;/b&gt; (R11)&lt;br&gt;run link-commits after every session" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;" vertex="1" parent="1"><mxGeometry x="370" y="514" width="300" height="60" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Knowledge-base push&lt;/b&gt; (R9)&lt;br&gt;send chat.md on session end" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;" vertex="1" parent="1"><mxGeometry x="370" y="584" width="300" height="60" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Indexer&lt;/b&gt; (R2 R6 R7 R14 R16 R19)&lt;br&gt;• prompts, replies, thinking, tool calls&lt;br&gt;• file changes: hunks + line counts, actor ai_edit / ai_command / human&lt;br&gt;• test runs per test (pytest, jest…)&lt;br&gt;• sub-agents (type, task, model, result)&lt;br&gt;• corrections, compactions, costs, identity" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="710" y="124" width="300" height="150" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Hierarchy linker&lt;/b&gt;&lt;br&gt;account → project → chat → sessions" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="710" y="284" width="300" height="50" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Catalog&lt;/b&gt; – readable JSON per chat (R8 part)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="710" y="344" width="300" height="50" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Decisions&lt;/b&gt; (R10 R13 R15)&lt;br&gt;session end / 15 quiet min → digest →&lt;br&gt;call 1 write → call 2 review →&lt;br&gt;CCP checks files + thinking by line → save" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="710" y="404" width="300" height="90" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;ccp-audit&lt;/b&gt; (R11)&lt;br&gt;history · why &amp;lt;file&amp;gt; &amp;lt;line&amp;gt; · link-commits&lt;br&gt;works, but command line only" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="710" y="504" width="300" height="70" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;Persona mapper&lt;/b&gt; (R16)&lt;br&gt;agent type → coder / tester / reviewer / security" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="710" y="584" width="300" height="55" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;Flow-graph builder&lt;/b&gt; (R14 R15)&lt;br&gt;prompt intent → options → choice → edit →&lt;br&gt;test → fix → commit; deviation; driver = test" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;" vertex="1" parent="1"><mxGeometry x="710" y="649" width="300" height="80" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;Markdown exporter&lt;/b&gt; (R8) – chat.md" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;" vertex="1" parent="1"><mxGeometry x="710" y="739" width="300" height="50" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;MinIO ccp-raw&lt;/b&gt;&lt;br&gt;raw redacted JSONL + attachments" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1050" y="124" width="300" height="60" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;MinIO catalog/&lt;/b&gt;&lt;br&gt;accounts/…/projects/…/chats/&amp;lt;date__title&amp;gt;/&lt;br&gt;chat · messages · 03_decisions.json · tests" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1050" y="194" width="300" height="75" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;PostgreSQL ccp&lt;/b&gt; (R18) · migrations 001–019&lt;br&gt;session · event · chat_session · job&lt;br&gt;claude_account · project · session_env&lt;br&gt;file_change · commit_link · test_run · test_case&lt;br&gt;agent_run · thinking · compaction · correction&lt;br&gt;decision · model_usage · session_cost · redaction_log&lt;br&gt;ui_user · ui_access_log" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1050" y="279" width="300" height="170" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;Capture Git repo&lt;/b&gt; (R12)&lt;br&gt;full tree per reply, original layout (opt-in)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1050" y="459" width="300" height="60" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;New&lt;/b&gt;: flow_edge · prompt_intent&lt;br&gt;persona on agent_run&lt;br&gt;MinIO 04_flow.json · chat.md" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;" vertex="1" parent="1"><mxGeometry x="1050" y="529" width="300" height="75" as="geometry"/></mxCell><mxCell id="c36" value="&lt;b&gt;Persona memory store&lt;/b&gt; (R17)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;" vertex="1" parent="1"><mxGeometry x="1050" y="614" width="300" height="55" as="geometry"/></mxCell><mxCell id="c37" value="&lt;b&gt;LLM call 1 · write&lt;/b&gt;&lt;br&gt;claude -p · Opus 5.5 · no tools/MCP/skills&lt;br&gt;≈5.5k in / 1.1k out · $0.07" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;al