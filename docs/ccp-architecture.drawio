="0"/><mxCell id="1" parent="0"/><mxCell id="c193" value="&lt;b&gt;Roadmap to the full system&lt;/b&gt; (each phase ships with tests, docs and a migration if needed)" style="text;html=1;fontSize=18;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1500" height="40" as="geometry"/></mxCell><mxCell id="c194" value="&lt;b&gt;Phase 1 · Switch on what exists&lt;/b&gt;&lt;br&gt;&lt;br&gt;• turn on hidden snapshots (R3 R12)&lt;br&gt;• run link-commits after each session (R11)&lt;br&gt;• test desktop app (R5)&lt;br&gt;• CLAUDE.md reasoning rule (R13)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="280" height="200" as="geometry"/></mxCell><mxCell id="c195" value="&lt;b&gt;Phase 2 · Full traceability&lt;/b&gt;&lt;br&gt;&lt;br&gt;• commit trailer CCP-Chat (R11)&lt;br&gt;• reverse-trace page: file + line → chat&lt;br&gt;• snapshot files in Explorer (R12)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;" vertex="1" parent="1"><mxGeometry x="320" y="80" width="280" height="200" as="geometry"/></mxCell><mxCell id="c196" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;" edge="1" parent="1" source="c194" target="c195"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c197" value="&lt;b&gt;Phase 3 · Reasoning and test loop&lt;/b&gt;&lt;br&gt;&lt;br&gt;• prompt intent, options offered, recommended&lt;br&gt;• deviation (recommended vs chosen vs built)&lt;br&gt;• flow graph + view (R14)&lt;br&gt;• driver = test result (R15)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;" vertex="1" parent="1"><mxGeometry x="620" y="80" width="280" height="200" as="geometry"/></mxCell><mxCell id="c198" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;" edge="1" parent="1" source="c195" target="c197"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c199" value="&lt;b&gt;Phase 4 · Agents and knowledge&lt;/b&gt;&lt;br&gt;&lt;br&gt;• persona mapping (R16)&lt;br&gt;• chat.md export (R8)&lt;br&gt;• push to knowledge base (R9)&lt;br&gt;• memory watcher (R13 R19)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;" vertex="1" parent="1"><mxGeometry x="920" y="80" width="280" height="200" as="geometry"/></mxCell><mxCell id="c200" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;" edge="1" parent="1" source="c197" target="c199"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c201" value="&lt;b&gt;Phase 5 · Governance&lt;/b&gt;&lt;br&gt;&lt;br&gt;• per-persona memory (R17)&lt;br&gt;• master-reviewer page&lt;br&gt;• cost budget per day" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;" vertex="1" parent="1"><mxGeometry x="1220" y="80" width="280" height="200" as="geometry"/></mxCell><mxCell id="c202" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;" edge="1" parent="1" source="c199" target="c201"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>