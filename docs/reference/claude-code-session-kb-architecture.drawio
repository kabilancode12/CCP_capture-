        <!-- Title -->
        <mxCell id="title" value="&lt;b&gt;Claude Code Session Capture &amp;amp; Knowledge Base — Architecture&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#666666&quot;&gt;Redaction happens on the laptop; everything after it is rebuilt on the server&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="20" y="10" width="900" height="50" as="geometry" />
        </mxCell>

