# --- Secrets and local configuration (never commit) ---
.env
*.pem
*.key

# --- Captured data: transcripts can contain secrets and personal data ---
# Real transcripts must never enter Git. Test fixtures are written by hand and live in tests/fixtures/.
*.jsonl
!tests/fixtures/*.jsonl
outbox/
minio-data/
*.dump

# --- Python ---
__pycache__/
*.py[cod]
.venv/
*.egg-info/
dist/
build/

# --- Tool caches and reports ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Editors and OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
